NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# La tienda permanece en vista previa y no procesa pagos reales.

# Solo Preview. Nunca usar credenciales reales en este flujo de prueba.
MERCADOPAGO_MODE=test
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Clave secreta de Supabase para el backend. Nunca NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Firma de notificaciones, obtenida en la app de Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=

# ID de la cuenta vendedora de pruebas, desde Mercado Pago Developers.
MERCADOPAGO_TEST_SELLER_ID=

# Preparación de la tienda oficial. Configurar solo en Vercel Production.
# Mantener el interruptor apagado hasta validar el dominio y la notificación.
# MERCADOPAGO_MODE=production
MERCADOPAGO_PRODUCTION_ACCESS_TOKEN=
MERCADOPAGO_PRODUCTION_WEBHOOK_SECRET=
MERCADOPAGO_ENABLE_PRODUCTION=false
